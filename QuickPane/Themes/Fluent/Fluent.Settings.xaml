<!--
    QuickPane's ported Fluent theme (see NOTICE.md in this folder for the licence and source
    commit). Entry dictionary for the Settings window only: merges the subset of
    Microsoft's WPF Fluent theme (dotnet/wpf, commit dbd3026982f09a279e4595666c07bb6136f579c3,
    src/Microsoft.DotNet.Wpf/src/Themes/PresentationFramework.Fluent/) that a settings window
    needs. See NOTICE.md in this folder for the licence. This dictionary does NOT include a
    light/dark/high-contrast colour dictionary: FluentThemeService adds one as a sibling
    entry in the Settings window's own Resources.MergedDictionaries (this dictionary is the
    other sibling), and swaps that one entry live on a theme change. Nearly every colour and
    brush below is a DynamicResource, which resolves against the live resource chain at the
    element level regardless of which merged dictionary defines it, so the colour file does
    not need to be nested inside this one for that swap to reach these styles.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>

        <!-- Theme-independent variables, fonts, static (non-theme) colours, focus visuals. -->
        <ResourceDictionary Source="Resources/Variables.xaml" />
        <ResourceDictionary Source="Resources/Fonts.xaml" />
        <ResourceDictionary Source="Resources/StaticColors.xaml" />
        <ResourceDictionary Source="Resources/DefaultFocusVisualStyle.xaml" />
        <ResourceDictionary Source="Resources/DefaultContextMenu.xaml" />

        <!-- Control styles. Each file is self-contained except MenuItem.xaml, which merges
             ScrollViewer.xaml itself, because MenuItem.xaml's submenu scroll viewer style uses
             BasedOn="{StaticResource {x:Type ScrollViewer}}" (see the comment in that file) and
             StaticResource lookup for a merged dictionary's own content does not see sibling
             entries merged here, only that file's own merged dictionaries. QuickPane change: do
             not also list Styles/ScrollViewer.xaml here, or it parses twice; MenuItem.xaml's own
             merge already carries its implicit ScrollViewer style into the window. Window.xaml,
             DocumentViewer.xaml, and every DataGrid/Calendar/DatePicker/NavigationWindow/
             Frame/RichTextBox/ToolBar/StatusBar/GridView-related style were skipped: Settings
             does not need them, and the first two need WPF-internal types that are not part
             of the public .NET Framework 4.8 surface. -->
        <ResourceDictionary Source="Styles/Button.xaml" />
        <ResourceDictionary Source="Styles/RepeatButton.xaml" />
        <ResourceDictionary Source="Styles/ToggleButton.xaml" />
        <ResourceDictionary Source="Styles/CheckBox.xaml" />
        <ResourceDictionary Source="Styles/RadioButton.xaml" />
        <ResourceDictionary Source="Styles/TextBox.xaml" />
        <ResourceDictionary Source="Styles/PasswordBox.xaml" />
        <ResourceDictionary Source="Styles/ComboBox.xaml" />
        <ResourceDictionary Source="Styles/ScrollBar.xaml" />
        <ResourceDictionary Source="Styles/Thumb.xaml" />
        <ResourceDictionary Source="Styles/ListBox.xaml" />
        <ResourceDictionary Source="Styles/ListBoxItem.xaml" />
        <ResourceDictionary Source="Styles/Expander.xaml" />
        <ResourceDictionary Source="Styles/ToolTip.xaml" />
        <ResourceDictionary Source="Styles/Menu.xaml" />
        <ResourceDictionary Source="Styles/ContextMenu.xaml" />
        <ResourceDictionary Source="Styles/MenuItem.xaml" />
        <ResourceDictionary Source="Styles/Separator.xaml" />
        <ResourceDictionary Source="Styles/Slider.xaml" />
        <ResourceDictionary Source="Styles/ProgressBar.xaml" />
        <ResourceDictionary Source="Styles/Hyperlink.xaml" />
        <ResourceDictionary Source="Styles/TextBlock.xaml" />
        <ResourceDictionary Source="Styles/Label.xaml" />
        <ResourceDictionary Source="Styles/GroupBox.xaml" />

    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
